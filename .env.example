# Copy to .env and fill in. Never commit .env.

# Live model calls. Leave unset to run entirely on the deterministic engine.
#
# The provider, endpoint, model and key are all set in Settings once the system
# is running — these are only the boot defaults. Anthropic, Google Gemini,
# OpenAI and anything OpenAI-compatible are supported; Gemini has a free tier.
# ANTHROPIC_API_KEY=sk-ant-...

# Model used by the four agents when a key is present.
MODEL=claude-opus-5

# Run the agents on the encoded engine instead of a model: no API key, no
# network, no rate limit. This is how `npm test` runs, and it is the only way
# to demonstrate the encounter flow without a provider.
#
# Development only, and enforced rather than documented: the server refuses to
# start when this is set and NODE_ENV is production, because the interface goes
# on naming the model while stand-ins answer. Never point it at real records.
# MODEL_TEST_DOUBLE=1

# Server. API_PORT rather than PORT: dev harnesses inject PORT for the client.
API_PORT=5174

# Where the dev client listens, and where its /api proxy points. Both are read
# by vite.config.ts, so two checkouts of this repository — a git worktree and
# the branch it came from, say — can run side by side without one of them
# silently proxying its API calls into the other's database. Leave unset for
# the defaults below.
# CLIENT_PORT=5173

# Number of reverse proxies in front of this server. Leave at 0 when exposed
# directly. Set to 1 behind a single Caddy or nginx, or rate limiting will count
# the whole internet as one client. Do not set it higher than the number of
# proxies you actually control: each hop you trust is a header a client could
# otherwise forge.
TRUST_PROXY=0

# Secret used to sign the session cookie. REQUIRED in production.
#
# Deliberately left blank rather than given a placeholder: a shipped default
# would mean every installation that copied this file shared one signing key,
# and anyone who had read this repository could forge a session for any
# clinician. `npm run setup` writes a real one for you.
#
# To generate one by hand:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the SQLite database lives. Back this file up; it is the whole record
# system. In Docker this is overridden to the mounted volume.
# DB_PATH=./data/clinic.db

# Transcription. Browser speech recognition needs no key but sends audio to the
# browser vendor; AssemblyAI is configured in Settings, not here.

# --- Demo only ---------------------------------------------------------------
# The sign-in created by `npm run seed:demo`, which loads the fictional
# population. A real clinic uses `npm run setup` instead, which asks for these
# and generates a password — neither is read from this file.
CLINICIAN_EMAIL=a.thomas@clinic.example
CLINICIAN_PASSWORD=clinic-demo
