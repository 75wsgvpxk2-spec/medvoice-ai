# Copy to .env and fill in. Never commit .env.

# Live model calls. Leave unset to run entirely on the deterministic engine.
# ANTHROPIC_API_KEY=sk-ant-...

# Model used by the four agents when a key is present.
MODEL=claude-opus-5

# Server. API_PORT rather than PORT: dev harnesses inject PORT for the client.
API_PORT=5174

# Secret used to sign the session cookie. Any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite database lives. Back this file up; it is the whole record
# system. In Docker this is overridden to the mounted volume.
# DB_PATH=./data/clinic.db

# Transcription. Browser speech recognition needs no key but sends audio to the
# browser vendor; AssemblyAI is configured in Settings, not here.

# --- Demo only ---------------------------------------------------------------
# The sign-in created by `npm run seed:demo`, which loads the fictional
# population. A real clinic uses `npm run setup` instead, which asks for these
# and generates a password — neither is read from this file.
CLINICIAN_EMAIL=a.thomas@clinic.example
CLINICIAN_PASSWORD=clinic-demo
